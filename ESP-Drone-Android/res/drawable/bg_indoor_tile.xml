<?xml version="1.0" encoding="utf-8"?>
<!-- One object tile of the Indoor Map screen's tiles row (the Vacuum Map Card's tiles-wrapper).
     Một ô đối tượng của hàng ô trên màn Indoor Map (tiles-wrapper của Vacuum Map Card). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/fly_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/fly_line" />
    <corners android:radius="8dp" />
</shape>
