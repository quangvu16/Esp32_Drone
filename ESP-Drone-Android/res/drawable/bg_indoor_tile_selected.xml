<?xml version="1.0" encoding="utf-8"?>
<!-- The selected object tile of the Indoor Map screen's tiles row.
     Ô đối tượng đang chọn trên hàng ô của màn Indoor Map. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/fly_surface" />
    <stroke
        android:width="2dp"
        android:color="@color/fly_ink" />
    <corners android:radius="8dp" />
</shape>
