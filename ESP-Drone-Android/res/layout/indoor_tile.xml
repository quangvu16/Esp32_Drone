<?xml version="1.0" encoding="utf-8"?>
<!-- One tile of the Indoor Map screen's tiles row: the object's type icon plus its label
     ("Keep-out 1", "Corridor 2", "WP 3"), like the Vacuum Map Card's predefined-selection tiles. -->
<!-- Một ô trên hàng ô của màn Indoor Map: biểu tượng kiểu của đối tượng kèm nhãn
     ("Keep-out 1", "Corridor 2", "WP 3"), như các ô predefined-selection của Vacuum Map Card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_indoor_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/indoor_tile_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/indoor_tile_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:textColor="@color/fly_ink"
        android:textSize="12sp" />
</LinearLayout>
