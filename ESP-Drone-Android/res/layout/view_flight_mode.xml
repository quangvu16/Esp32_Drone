<?xml version="1.0" encoding="utf-8"?>
<!-- Flight-mode controls (PROTOCOL.md section 5). Kept in one row of groups so the
     panel fits above the joysticks without covering them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_open_tune"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PID Tune" />

        <Button
            android:id="@+id/button_open_gps"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GPS Nav" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Spinner
            android:id="@+id/spinner_flight_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/text_flight_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="—"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_takeoff"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Takeoff" />

        <Button
            android:id="@+id/button_land"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Land" />

        <Button
            android:id="@+id/button_arm"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Arm" />

        <Button
            android:id="@+id/button_disarm"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disarm" />

        <Button
            android:id="@+id/button_emergency"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EMERGENCY"
            android:textColor="#FFFFFF"
            android:background="#B71C1C" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hover thrust"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <SeekBar
            android:id="@+id/seek_hover_thrust"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="47000" />

        <TextView
            android:id="@+id/text_hover_thrust"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="30000"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>

    <!-- Stated plainly because the board has only an MPU6500. The UI must not
         imply altitude hold or GPS tracking that the hardware cannot deliver. -->
    <TextView
        android:id="@+id/text_hardware_limits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hold keeps a thrust level, not an altitude (no barometer). AUTO is takeoff-hover-land, not waypoints. Follow/RTH use accelerometer dead reckoning and drift."
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#8D6E63" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ToggleButton
            android:id="@+id/toggle_tilt_control"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="Tilt control: OFF"
            android:textOn="TILT CONTROL ACTIVE" />

        <TextView
            android:id="@+id/text_tilt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Phone tilt is inert until you switch it on."
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>
</LinearLayout>
