<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">#3EC2FC</item>
        <item name="colorPrimaryDark">#99acc1</item>
        <item name="colorAccent">#FF4081</item>
    </style>

    <!-- Fly-screen buttons (redesign). MaterialButton styles: no caps, no inset,
         44dp minimum touch height, icon beside the text. -->
    <style name="Fly.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <style name="Fly.Button.Primary">
        <item name="backgroundTint">@color/fly_accent</item>
        <item name="android:textColor">@color/fly_surface</item>
        <item name="iconTint">@color/fly_surface</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="iconSize">22dp</item>
    </style>

    <style name="Fly.Button.Danger">
        <item name="backgroundTint">@color/fly_danger</item>
        <item name="android:textColor">@color/fly_surface</item>
        <item name="iconTint">@color/fly_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Fly.Button.Outline">
        <item name="backgroundTint">@color/fly_surface</item>
        <item name="android:textColor">@color/fly_ink</item>
        <item name="iconTint">@color/fly_ink</item>
        <item name="strokeColor">@color/fly_control</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- One option of a segmented row (tabs, flight mode). Selection is set in code. -->
    <style name="Fly.Button.Segment">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/fly_muted</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
