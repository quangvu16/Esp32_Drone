source 'https://github.com/CocoaPods/Specs.git'
platform :ios, '15.0'
use_frameworks!

target 'Crazyflie client' do
  pod 'CocoaAsyncSocket'
  pod 'AFNetworking', '~> 4.0'
end

# Xcode 27 rejects deployment targets below iOS 15. The pods still carry
# 8.0/9.0 from their podspecs, so force every pod target up to the floor.
post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # The app builds for Mac Catalyst too (SUPPORTS_MACCATALYST in the app
      # target), and both pods ship a macOS platform, so let every pod target
      # build for the Mac as well. CocoaPods does not set this itself.
      # App cũng build cho Mac Catalyst (SUPPORTS_MACCATALYST trong target app),
      # và cả hai pod đều có nền tảng macOS, nên cho phép mọi target pod build
      # cho Mac. CocoaPods tự nó không đặt cài đặt này.
      config.build_settings['SUPPORTS_MACCATALYST'] = 'YES'
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '10.15'

      # Xcode 27.1's modules-verifier rejects the -F framework search paths
      # Xcode itself hands it (Unknown option '-F...') and fails the build on
      # the Pods umbrella framework. Verification of vendored pods is not ours
      # to own — skip it for pod targets; the app keeps every check.
      # modules-verifier của Xcode 27.1 từ chối đường dẫn -F do chính Xcode
      # truyền vào nên build lỗi ở khung Pods. Pod là mã nguồn bên thứ ba, không
      # cần xác minh module của chúng; target app vẫn giữ mọi bước kiểm tra.
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'

      # Not our code to modernise. AFNetworking still calls the SecTrust and
      # UTType APIs deprecated in iOS 14/15, and CocoaAsyncSocket's TLS layer
      # is built on SecureTransport, deprecated since iOS 13. Neither the
      # certificate-pinning nor the TLS code is reachable from here — we use
      # CocoaAsyncSocket for UDP and AFNetworking for plain HTTP — so the calls
      # are dead weight, but their warnings would bury anything real in our own
      # sources. Suppress them for pod targets only; the app keeps every warning.
      config.build_settings['WARNING_CFLAGS'] =
        '$(inherited) -Wno-deprecated-declarations -Wno-strict-prototypes'
    end
  end

  # AFNetworking 4.0.1 imports <netinet6/in6.h>, which the iOS 27 SDK marks
  # private ("Use of private header from outside its module"). The public
  # <netinet/in.h> it already imports provides sockaddr_in6 / AF_INET6, so the
  # private import is redundant — strip it. Done here so `pod install` keeps it.
  afn = Dir.glob(File.join(installer.sandbox.root, 'AFNetworking', 'AFNetworking', '*.m'))
  afn.each do |path|
    src = File.read(path)
    next unless src.include?('<netinet6/in6.h>')
    File.chmod(0644, path)              # CocoaPods marks pod sources read-only
    File.write(path, src.gsub(%r{^\s*#import <netinet6/in6\.h>\s*\n}, ''))
    puts "  Patched #{File.basename(path)}: removed private netinet6/in6.h import"
  end
end
